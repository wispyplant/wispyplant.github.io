---
import BlogCard from '@/components/BlogCard.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { buttonVariants } from '@/components/ui/button'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getRecentPosts } from '@/lib/data-utils'

const blog = await getRecentPosts(SITE.featuredPostCount)
---

<Layout>
  <PageHead slot="head" title="Home" />
  <section>
    <div class="rounded-lg border">
      <div class="flex flex-col space-y-1.5 p-6">
        <h3 class="text-3xl leading-none font-medium">Hello, I'm an independent researcher and artist specialising in climate change</h3> 
        <br>
        <p class="text-muted-foreground text-med">
          climate change &bull; history &bull; technology &bull; justice
        </p>
      </div>   
      <img src="/page_media/aytc_profile_credit_louise_hobson.png" alt="Angela in an orange jumper crouched at a rocky seaside. She wears a black tote bad and a grey cap.">
     <br>
      <div class="p-6 pt-0"> 
        <p class="text-muted-foreground mb-2 text-med">
        "Angela YT Chan is an independent researcher and artist investigating climate change narratives through colonial history, data, technology, and justice.
        <br><br>
        Her activities often include interdisciplinary collaborations in journalism, policy, academia and activism, merging artistic and digital research methods. Angela's ongoing project 'Critiquing a 'Sustainable Military'' explores how public narratives are shaped around environmental security and conflict technologies, within the unfolding history of climate colonialism. She has held numerous residencies, including Arts Catalyst, FACT/Jerwood, Sonic Acts, Primary, Abandon Normal Devices, HGCRC (Archaeology, University of York), Critical Infrastructures and Image Politics, and Tactical Tech.
        <br><br>
        Angela has produced curatorial projects and workshops, collaborating with artists, activists and youth groups (formerly under the name Worm: art + ecology, 2014-2020). She co-founded the London Chinese Science Fiction Group (2019-2021), before co-directing the longstanding London Science Fiction Research Community (2020-). As a university educator she has supervised MA dissertations in critical media studies and taught climate colonialism, environmental and social art, games and speculative fiction. She also mentors artists working on digital media technologies.
        <br><br>
        Angela is also a research consultant, having worked on climate projects for major cultural institutions and in international climate and cultural policy at Julie's Bicycle. Briefly in industry, she worked as a data engineer and researched into generative AI and sustainability. She sometimes works with INTERPRT - a research agency that pursues environmental justice through spatial and visual investigations - and has collaborated with Arena for Journalism in Europe. 
        <br><br>
        With Critical Infrastructures and Image Politics (CIIP) at Winchester School of Art and University of Southampton, Angela is the Research Fellow in Artistic Research for SOUNDSCALE, an interdisciplinary UKRI-funded project that focuses on citizen-centric research of the emerging technology Distributed Acoustic Sensing (DAS). She co-leads on developing artistic methods to critically investigate dark fibre’s infrastructural history, environmental and ethical issues, and what constitutes collective tech justice. Her activities in this include artwork creation, low-tech game production, workshops, curation and writing."
        </p>
      </div>
    </div>
  </section>

<section>
    <div class="rounded-lg border">
      <div class="flex flex-col space-y-1.5 p-6">
        <h3 class="text-2xl leading-none font-medium">Contact me:</h3> 
        <br>
        <p class="text-muted-foreground text-med">
          Always happy to chat, reach me by email hello [at] angelaytchan [dot] net . 
          <br>I'm also on <u><a href="https://www.linkedin.com/in/angelaytchan/">linkedin</a></u> and sometimes <u><a href="https://bsky.app/profile/angelaytchan.net">bluesky</a></u>.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="rounded-lg border">
      <div class="flex flex-col space-y-1.5 p-6">
    <h2 class="text-2xl font-medium">Current activities</h2>
    <br>
    <ul class="flex flex-col gap-y-4">
      {
        blog.map((post) => (
          <li>
            <BlogCard entry={post} />
          </li>
        ))
      }
    </ul>
    <div class="flex justify-center">
      <Link
        href="/blog"
        class={buttonVariants({ variant: 'ghost' }) + ' group'}
      >
        See all activities <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>
  </section>
</Layout>
